# Copy to .env.local for local dev. Never commit real values (.env* is gitignored).

# --- Local dev (SQLite) ---
# File-based SQLite DB. See LOCAL_DEV_DB_OVERRIDE deviation in 01-02-SUMMARY.md
# for why this replaces plan 01-02's Postgres for local development.
DATABASE_URI=file:./payload.db

# Generate with: openssl rand -base64 32 (or `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`)
PAYLOAD_SECRET=<generate-a-strong-random-value>

# Absolute canonical origin -- required by metadataBase, sitemap.ts, and every
# hreflang/OG URL (src/lib/seo/alternates.ts). Falls back to localhost in dev
# ONLY; a localhost value here on a production build is a severe SEO-05
# canonical-conflict bug -- set the real Vercel project env var (staging URL
# now, https://vnpglobal.in at DNS cutover -- playbook/DECISION_LOG.md D-17
# supersedes the earlier staragrevolution.com plan) before any prod deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Prod-only (Wave 4 deploy target — EU region, D-04) ---
# Swap payload.config.ts's `db` block to @payloadcms/db-postgres and set:
# DATABASE_URL=<eu-region-postgres-connection-string-with-sslmode=require>

# Swap Media's storage to @payloadcms/storage-s3 (s3Storage in the `plugins`
# array) and set:
# S3_BUCKET=<changeme>
# S3_ACCESS_KEY_ID=<changeme>
# S3_SECRET_ACCESS_KEY=<changeme>
# S3_REGION=<eeur-or-eu-central-1>
# S3_ENDPOINT=<changeme-required-for-r2-non-aws>

# Vercel Blob storage token (media uploads) — set by Vercel automatically
# when the Blob store is attached to the project; only needed manually for
# local dev against a real blob store.
BLOB_READ_WRITE_TOKEN=<changeme>

# --- Analytics (ANALY-01 — Plausible chosen, D-49) ---
# Cookieless, no consent banner. Code is launch-ready (src/lib/analytics.ts,
# script mounted in [locale]/layout.tsx) but no-ops until this is set. Create
# a Plausible site for the production domain, then set this in Vercel's
# project env vars — required for any analytics data to flow.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=<changeme>

# --- Contact form (Phase 4 — RFQ/inquiry) ---
RESEND_API_KEY=<changeme>
RESEND_FROM_ADDRESS=<changeme>
SALES_INBOX_ADDRESS=<changeme>
TURNSTILE_SECRET_KEY=<changeme>
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<changeme>

# Optional CRM webhook — inquiry payload POSTed here if set, no-ops if unset.
# CRM_WEBHOOK_URL=<changeme>
