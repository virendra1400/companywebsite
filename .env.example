# Copy to .env.local for local dev. Never commit real values (.env* is gitignored).

# --- Local dev (SQLite) ---
# File-based SQLite DB. See LOCAL_DEV_DB_OVERRIDE deviation in 01-02-SUMMARY.md
# for why this replaces plan 01-02's Postgres for local development.
DATABASE_URI=file:./payload.db

# Generate with: openssl rand -base64 32 (or `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`)
PAYLOAD_SECRET=<generate-a-strong-random-value>

# --- Prod-only (Wave 4 deploy target — EU region, D-04) ---
# Swap payload.config.ts's `db` block to @payloadcms/db-postgres and set:
# DATABASE_URL=<eu-region-postgres-connection-string-with-sslmode=require>

# Swap Media's storage to @payloadcms/storage-s3 (s3Storage in the `plugins`
# array) and set:
# S3_BUCKET=<changeme>
# S3_ACCESS_KEY_ID=<changeme>
# S3_SECRET_ACCESS_KEY=<changeme>
# S3_REGION=<eeur-or-eu-central-1>
# S3_ENDPOINT=<changeme-required-for-r2-non-aws>
